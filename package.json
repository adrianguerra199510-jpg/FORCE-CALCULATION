{
  "name": "force-calculation",
  "productName": "Force Calculation REP-2021",
  "version": "1.2.3",
  "description": "Cálculo de cargas de viento y sismo según REP-2021 (Panamá) / ASCE 7-05, con visor 3D y reportes Word/PDF",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --dir",
    "postinstall": "node tools/vendor.js"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-semi-condensed": "^5.1.0",
    "docx": "^9.0.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "three": "^0.170.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "build": {
    "appId": "pa.forcecalculation.rep2021",
    "productName": "Force Calculation REP-2021",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.md",
      "!node_modules/@fontsource/**/*",
      "node_modules/@fontsource/barlow/files/barlow-latin-{400,500,600,700}-normal.woff2",
      "node_modules/@fontsource/barlow-semi-condensed/files/barlow-semi-condensed-latin-{400,600}-normal.woff2"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ForceCalculation-REP2021-Setup-${version}.${ext}",
      "shortcutName": "Force Calculation REP-2021",
      "createDesktopShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "fcp",
        "name": "Proyecto Force Calculation",
        "description": "Proyecto de cargas de viento y sismo"
      }
    ],
    "compression": "maximum"
  },
  "author": "Force Calculation"
}
